# SEVA AI Kiosk - Environment Configuration
# Copy to .env and fill in your values

# LiveKit Server (Real-time Voice)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret
LIVEKIT_TOKEN=your_participant_token

# Google Gemini (LLM)
GOOGLE_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (STT/TTS fallback)
OPENAI_API_KEY=your_openai_api_key

# WhatsApp Cloud API (Document Delivery)
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_APP_ID=your_app_id
WHATSAPP_APP_SECRET=your_app_secret

# SEVA AI Configuration
SEVA_LANGUAGE=mr-IN
SEVA_HEADLESS=false
SEVA_DEMO_MODE=true

# Hardware
THERMAL_PRINTER_NAME=POS-58
ADB_PATH=adb
WEBCAM_INDEX=0

# Database
OFFLINE_DB_PATH=data/seva_offline.db